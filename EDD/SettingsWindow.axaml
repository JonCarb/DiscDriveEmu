<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="961" d:DesignHeight="822"
        x:Class="EDD.SettingsWindow"
        Title="Settings">
        
        <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <Border
                    Height="332"
                    Margin="105,26,105,0"
                    Background="#FF525252"
                    BorderBrush="White"
                    BorderThickness="2">

                    <StackPanel>
                        <TextBlock x:Name="Label" Text="Emulator Paths" FontSize="35" FontStyle="Italic" Foreground="White" Margin="1,1,1,20" FontWeight="Bold" HorizontalAlignment="Center" />

                        <TextBlock x:Name="Dolphin" Text="Dolphin Path:" FontStyle="Italic" Foreground="#FFCCCCCC" FontSize="22" Margin="10,0,10,5"/>
                        <TextBlock x:Name="Xemu" Text="Xemu Path:" FontStyle="Italic" Foreground="#FFCCCCCC" FontSize="22" Margin="10,0,10,5"/>
                        <TextBlock x:Name="Xenia" Text="Xenia Path:" FontStyle="Italic" Foreground="#FFCCCCCC" FontSize="22" Margin="10,0,10,5"/>
                        <TextBlock x:Name="PCSX2" Text="PCSX2 Path:" FontStyle="Italic" Foreground="#FFCCCCCC" FontSize="22" Margin="10,0,10,5"/>
                        <TextBlock x:Name="RPCS3" Text="RPCS3 Path:"  FontStyle="Italic" Foreground="#FFCCCCCC" FontSize="22" Margin="10,0,10,5"/>
                        <TextBlock x:Name="Cemu" Text="Cemu Path:"  FontStyle="Italic" Foreground="#FFCCCCCC" FontSize="22" Margin="10,0,10,5"/>
                        <TextBlock x:Name="Duckstation" Text="Duckstation Path:"  FontStyle="Italic" Foreground="#FFCCCCCC" FontSize="22" Margin="10,0,10,5"/>
                        
                        <TextBlock x:Name="Dumper" Text="Disc Dumper Path:"  FontStyle="Italic" Foreground="#FFCCCCCC" FontSize="22" Margin="10,0,10,5"/>

                        <Button 
                            x:Name="AddPath" 
                            Width="200" 
                            Height="35" 
                            HorizontalAlignment="Right" 
                            Background="{x:Null}" 
                            FontSize="22" 
                            Content="Add..." 
                            Margin="0,5,10,0" 
                            FontFamily="Yu Gothic UI" 
                            Cursor="Hand" 
                            VerticalAlignment="Bottom" 
                            Foreground="White" 
                            BorderBrush="#FF1FFF00"
                            Padding="10,1"
                            Click="AddPaths"/>
                    </StackPanel>
                </Border>

                <Border
                    Margin="105,20,105,0"
                    Background="#FF525252"
                    BorderBrush="White"
                    BorderThickness="2">

                    <StackPanel>
                        <TextBlock Text="Installed Games" FontSize="35" FontStyle="Italic" Foreground="White" Margin="0,0,0,20" FontWeight="Bold" HorizontalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="InstallPath" Text="Install Path:" FontSize="20" FontStyle="Italic" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </StackPanel>

                        <ItemsControl x:Name="InstallList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontStyle="Italic" Foreground="#FFCCCCCC" FontSize="22" Margin="10,10,10,5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <Button 
                                x:Name="DeleteBtn"
                                Content="Delete Games" 
                                Width="200" 
                                Height="35" 
                                Background="{x:Null}" 
                                Foreground="White" 
                                BorderBrush="Red" 
                                Cursor="Hand" 
                                FontSize="20" 
                                HorizontalAlignment="Right"
                                Margin="0,0,10,10"
                                Click="RemoveInstall"
                        />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer></Grid>
</Window>