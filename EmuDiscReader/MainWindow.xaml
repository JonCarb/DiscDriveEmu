<Window x:Class="EmuDiscReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmuDiscReader"
        xmlns:gif="http://wpfanimatedgif.codeplex.com" 
        mc:Ignorable="d"
        Title="Disc Reader" Height="1080" Width="1920">

    <Grid Background="Black">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image gif:ImageBehavior.AnimatedSource="/EmuDiscReader;component/Assets/spinningDisc.gif" Width="800" Height="800"/>
            <TextBlock x:Name="Description" Text="Please insert a Disc" FontSize="50" HorizontalAlignment="Center" FontStyle="Italic" Foreground="White"/>
            <ProgressBar x:Name="InstallBar" Minimum="0" Maximum="100" Value="0" Width="600" Height="20" Visibility ="Collapsed"/>
        </StackPanel>

        <Image Source="/EmuDiscReader;component/Assets/scanline.png"/>
        <Button Name="btn5" Width="200" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="White"
            Background="Gray" FontSize="15" Content="Settings" Margin="0,0,20,20"/>
       
    </Grid>
</Window>
