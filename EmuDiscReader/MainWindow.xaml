<Window x:Class="EmuDiscReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmuDiscReader"
        xmlns:gif="http://wpfanimatedgif.codeplex.com" 
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="#1E1E1E"
        Title="Disc Reader" Height="1080" Width="1920">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black" Offset="0"/>
                <GradientStop Color="#FF2C1961" Offset="0.6"/>
                <GradientStop Color="Black" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Viewbox
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Stretch="Uniform"
            StretchDirection="Both">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="1123">
                <Image 
                    x:Name ="Disc" 
                    gif:ImageBehavior.AnimatedSource="/EmuDiscReader;component/Assets/spinningDisc.gif" 
                    Width="800" 
                    Height="800"/>

                <TextBlock 
                    x:Name="Description" 
                    FontSize="50" 
                    HorizontalAlignment="Center" 
                    FontStyle="Italic" 
                    Foreground="White" 
                    Margin="0,-15,0,0" Height="88">
                    <Run x:Name="DescPrefix" Text=" Please insert a Disc" FontSize="60"/>
                    <InlineUIContainer BaselineAlignment="Center">
                        <Image 
                            x:Name="DescIcon"
                            Source="/EmuDiscReader;component/Assets/ButtonIcon-Xbox360-A.png" 
                            Height="79" 
                            Width="75" 
                            Margin="0,10,0,0"
                            Visibility="Collapsed"
                            Cursor="Hand"/>
                    </InlineUIContainer>
                    <Run x:Name="DescSuffix" Text="" FontSize="60"/>
                </TextBlock>
                <ProgressBar 
                    x:Name="InstallBar" 
                    Minimum="0" 
                    Maximum="100" 
                    Value="0" 
                    Width="800" 
                    Height="23" Margin="0,0,0,10" 
                    Visibility ="Collapsed"
                    />
            </StackPanel>
        </Viewbox>
        
        <Image Source="/EmuDiscReader;component/Assets/scanline.png" Stretch="Fill"/>

        <Grid 
            Margin="0,0,70,20" 
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="197"
            Height="40">

            <Button 
                x:Name="SettingsBTN" 
                Background="White" 
                FontSize="18" 
                Content="⚙️ Settings" 
                FontFamily="Yu Gothic UI" 
                Cursor="Hand" 
                Foreground="Black" 
                BorderBrush="Black" 
                Click="SettingsBTN_Click"/>

            <Image 
                x:Name="SettingBtnIcon"
                Source="/EmuDiscReader;component/Assets/ButtonIcon-Xbox360-B.png"
                Margin="195,-6,-58,-6"/>
        </Grid>

        <Border 
            BorderBrush="#FF9D9AFF"
            BorderThickness="2"
            CornerRadius="5"
            Width="197"
            Height="40"
            Margin="70,0,0,20"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Left">

            <Grid>
                <CheckBox 
                    x:Name="InstallBTN"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="18"
                    Content="⬇️ Install Game"
                    FontFamily="Yu Gothic UI"
                    Cursor="Hand"
                    Foreground="White"
                    HorizontalAlignment="Center" 
                    Checked="InstallBTN_Checked" 
                    Unchecked="InstallBTN_Unchecked" />

                <Image 
                    x:Name="InstallBtnIcon"
                    Source="/EmuDiscReader;component/Assets/ButtonIcon-Xbox360-X.png" 
                    Margin="-58,-6,195,-6"/>
            </Grid>
        </Border>

        <Border 
         BorderBrush="Red"
         BorderThickness="2"
         CornerRadius="5"
         Width="197"
         Height="40"
         Margin="0,20,70,0"
         VerticalAlignment="Top"
         HorizontalAlignment="Right">
            <Grid>
                <Button 
                x:Name="QuitBTN" 
                Background="{x:Null}" 
                FontSize="18" 
                Content="Quit" 
                FontFamily="Yu Gothic UI" 
                Cursor="Hand" 
                Foreground="White" 
                BorderBrush="Black" 
                 Click="QuitBTN_Click"/>
                <Image 
                x:Name="QuitBtnIcon"
                Source="/EmuDiscReader;component/Assets/ButtonIcon-Xbox360-Y.png"
                Margin="195,-6,-58,-6"/>
            </Grid>
        </Border>

    </Grid>
</Window>
