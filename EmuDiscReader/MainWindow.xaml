<Window x:Class="EmuDiscReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmuDiscReader"
        xmlns:gif="http://wpfanimatedgif.codeplex.com" 
        mc:Ignorable="d"
        Title="Disc Reader" Height="1080" Width="1920">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="Black" Offset="0"/>
                <GradientStop Color="#FF5932A2" Offset="0"/>
                <GradientStop Color="Black" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name ="Disc" gif:ImageBehavior.AnimatedSource="/EmuDiscReader;component/Assets/spinningDisc.gif" Width="800" Height="800"/>
            <TextBlock x:Name="Description" Text="Please insert a Disc" FontSize="50" HorizontalAlignment="Center" FontStyle="Italic" Foreground="White" Margin="0,5,0,100"/>
            <ProgressBar x:Name="InstallBar" Minimum="0" Maximum="100" Value="0" Width="600" Height="20" Visibility ="Collapsed"/>
        </StackPanel>

        <Image Source="/EmuDiscReader;component/Assets/scanline.png" Margin="-14,0,-11,0" OpacityMask="Red"/>
        
        <Button x:Name="SettingsBTN" Width="200" Height="40" HorizontalAlignment="Right"
            Background="#FF383838" FontSize="18" Content="Settings" Margin="0,0,20,20" 
            FontFamily="Sitka Subheading" FontWeight="Bold" BorderBrush="White" 
            Foreground="White" Cursor="Hand" VerticalAlignment="Bottom"/>
        
        <Button x:Name="InstallBTN" Width="200" Height="40" HorizontalAlignment="Left" FontSize="18" Content="Install" Margin="20,0,0,20" 
            FontFamily="Sitka Subheading" FontWeight="Bold" BorderBrush="White" 
            Foreground="White" Cursor="Hand" VerticalAlignment="Bottom">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" SpreadMethod="Reflect" MappingMode="Absolute">
                    <GradientStop Color="Black" Offset="1"/>
                    <GradientStop Color="#FF1A4CE8"/>
                    <GradientStop Color="#FF4100D4" Offset="0.317"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
    </Grid>
</Window>
