<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\ButtonIcon-PS4-Circle.png" />
    <None Remove="Assets\ButtonIcon-PS4-Cross.png" />
    <None Remove="Assets\ButtonIcon-PS4-Square.png" />
    <None Remove="Assets\ButtonIcon-Xbox360-A.png" />
    <None Remove="Assets\ButtonIcon-Xbox360-B.png" />
    <None Remove="Assets\ButtonIcon-Xbox360-X.png" />
    <None Remove="Assets\diskError.gif" />
    <None Remove="Assets\readingDisc.gif" />
    <None Remove="Assets\scanline.png" />
    <None Remove="Assets\spinningDisc.gif" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LTRData.DiscUtils.Iso9660" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Udf" Version="1.0.88" />
    <PackageReference Include="SDL3-CS" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.16" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ButtonIcon-PS4-Circle.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\ButtonIcon-PS4-Cross.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\ButtonIcon-PS4-Square.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\ButtonIcon-Xbox360-A.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\ButtonIcon-Xbox360-B.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\ButtonIcon-Xbox360-X.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\diskError.gif">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\readingDisc.gif">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\scanline.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\spinningDisc.gif">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
